# Environment Configuration Template for Production Deployment

# Server Configuration
PORT=3001
NODE_ENV=production

# Database - Use DATABASE_URL or individual settings
# For Railway/Render: They provide DATABASE_URL automatically
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@your-db-host:5432/proper_place

# If using individual credentials (fallback if DATABASE_URL not available):
DB_HOST=your-db-host.internal
DB_PORT=5432
DB_USER=proper_place_user
DB_PASSWORD=your-secure-password
DB_NAME=proper_place

# JWT Configuration - CHANGE THESE IN PRODUCTION!
JWT_SECRET=your-production-secret-key-minimum-32-characters-required-change-this
JWT_REFRESH_SECRET=your-production-refresh-secret-minimum-32-characters-required
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# CORS - Update with your actual frontend/app domains
CORS_ORIGIN=https://your-frontend-domain.com,https://app.yourdomain.com

# Logging
LOG_LEVEL=info

# Optional: Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-business-email@gmail.com
SMTP_PASS=your-app-password

# Optional: AWS S3 for Image Uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Optional: Stripe Payment
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Other Services
REDIS_URL=redis://localhost:6379
API_RATE_LIMIT=100
