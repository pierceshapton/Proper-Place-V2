# ===========================================
# Proper Place Backend - Environment Variables
# ===========================================
# SECURITY WARNING: Never commit .env to version control!
# Generate secure secrets with: openssl rand -base64 64

PORT=3001
NODE_ENV=development

# PostgreSQL Connection (REQUIRED)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proper_place_db

# JWT Configuration (REQUIRED IN PRODUCTION)
# Generate secure 64+ character secrets!
JWT_SECRET=your-super-secret-key-change-in-production-min-64-chars-use-openssl-rand
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-use-openssl-rand
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Logging
LOG_LEVEL=debug

# Email (optional, for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AWS S3 (optional, for image uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# DigitalOcean Spaces (for image storage - REQUIRED for production)
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=proper-place-images
DO_SPACES_REGION=lon1
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
DO_SPACES_CDN_URL=https://proper-place-images.lon1.cdn.digitaloceanspaces.com
