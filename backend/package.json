{
  "name": "proper-place-backend",
  "version": "1.0.0",
  "description": "Proper Place backend - Node.js + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:pm2": "pm2 startOrRestart ecosystem.config.js",
    "start:pm2:prod": "pm2 startOrRestart ecosystem.config.js --env production",
    "stop": "pm2 stop proper-place-backend",
    "restart": "pm2 restart proper-place-backend",
    "status": "pm2 status",
    "logs": "pm2 logs proper-place-backend --lines 100",
    "logs:error": "tail -100f ./logs/error.log",
    "pm2:setup": "pm2 startup && pm2 save",
    "pm2:delete": "pm2 delete all",
    "health": "curl -s http://localhost:3001/health | jq .",
    "db:migrate": "node src/migrations/run.js",
    "db:seed": "node src/seeds/seed.js",
    "test": "jest --detectOpenHandles",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.993.0",
    "axios": "^1.13.6",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.0",
    "firebase-admin": "^13.7.0",
    "helmet": "7.1.0",
    "joi": "17.11.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.5",
    "openai": "^6.35.0",
    "pg": "8.10.0",
    "pm2": "^6.0.14",
    "sharp": "^0.34.5",
    "stripe": "^20.3.0"
  },
  "devDependencies": {
    "eslint": "8.54.0",
    "jest": "29.7.0",
    "nodemon": "3.0.2",
    "supertest": "6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
